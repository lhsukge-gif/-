[Unit]
Description=Classroom Gallery
After=network.target

[Service]
Type=simple
User=gallery
Group=gallery
WorkingDirectory=/opt/gallery
Environment=PORT=8080
Environment=GALLERY_DATA_DIR=/var/lib/gallery
Environment=GALLERY_SEED_DB=/opt/gallery/backup/gallery.db
ExecStart=/bin/sh /opt/gallery/deploy/start.sh
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
